// ==========================================
// 1. 實作 Linked List 節點與 Stack (Template)
// ==========================================

// 定義 Linked List 的節點結構，使用 Template 支援各種類型
template <typename T>
struct Node {
    T data;             // 節點儲存的資料
    Node* next;         // 指向底下一格節點的指標
    Node(T val) : data(val), next(nullptr) {} // 建構子：初始化資料並將指標設為空
};

// 使用 Linked List 實作的堆疊類別 (後進先出 LIFO)
template <typename T>
class LinkedListStack {
private:
    Node<T>* topNode;   // 指向堆疊最頂端節點的指標

public:
    // 建構子：初始化時堆疊為空，頂端指標指向 nullptr
    LinkedListStack() : topNode(nullptr) {}

    // 解構子：在物件生命週期結束時，釋放所有動態配置的記憶體
    ~LinkedListStack() {
        while (!isEmpty()) { // 只要堆疊還沒空
            pop();           // 就持續彈出節點以釋放記憶體
        }
    }

    // 將資料推入堆疊頂端 (Push)
    void push(T val) {
        Node<T>* newNode = new Node<T>(val); // 動態配置一個新節點
        newNode->next = topNode;             // 新節點的下一個指向原本的頂端
        topNode = newNode;                   // 將頂端指標更新為新節點
    }

    // 將頂端的資料彈出堆疊 (Pop)
    void pop() {
        if (isEmpty()) {                     // 防呆機制：若堆疊是空的無法再彈出
            throw runtime_error("Error: Stack underflow.");
        }
        Node<T>* temp = topNode;             // 暫存目前的頂端節點
        topNode = topNode->next;             // 將頂端指標移至下一個節點
        delete temp;                         // 釋放舊頂端節點的記憶體
    }

    // 查看堆疊頂端的資料，但不移除它 (Peek/Top)
    T peek() const {
        if (isEmpty()) {                     // 防呆機制：若堆疊是空的無法查看
            throw runtime_error("Error: Stack is empty.");
        }
        return topNode->data;                // 回傳頂端節點的資料
    }

    // 檢查堆疊是否為空
    bool isEmpty() const {
        return topNode == nullptr;           // 若頂端指標為空，代表堆疊無資料
    }
};

// ==========================================
// 2. 輔助函式：判斷運算子與優先級
// ==========================================

// 判斷該字串是否為支援的數學運算子
bool isOperator(const string& token) {
    return token == "+" || token == "-" || token == "*" || token == "/" || token == "^" || token == "%";
}

// 取得四則運算子的權重優先級 (數字越大優先權越高)
int getPrecedence(char op) {
    if (op == '+' || op == '-') return 1;       // 加減法優先級最低 (1)
    if (op == '*' || op == '/' || op == '%') return 2; // 乘除、取餘優先級中等 (2)
    if (op == '^') return 3;                     // 次方運算優先級最高 (3)
    return 0;                                    // 括號或其他字元回傳 0
}

// ==========================================
// 3. Tokenizer (字串解析器)
// 負責處理多位數、浮點數與正確辨識「負號」
// ==========================================
vector<string> tokenize(const string& expr) {
    vector<string> tokens; // 儲存分割後的各個 Token (數字、運算子、括號)
    int n = expr.length(); // 取得運算式字串的總長度
    
    for (int i = 0; i < n; i++) {
        if (isspace(expr[i])) continue; // 如果是空格，直接略過不處理

        // 處理數字 (支援多位數整數與包含小數點的浮點數)
        if (isdigit(expr[i]) || expr[i] == '.') {
            string num = ""; // 用來拼湊完整數字的字串
            while (i < n && (isdigit(expr[i]) || expr[i] == '.')) {
                num += expr[i]; // 將連續的數字或小數點拼接到 num 之中
                i++;
            }
            tokens.push_back(num); // 將拼接好的完整數字放入 tokens 陣列
            i--; // 因為 while 結束時 i 多加了 1，需退回一格讓 for 迴圈下一次 +1 正確
        } 
        // 處理減號（必須區分是「減法運算子」還是數字前面的「負號」）
        else if (expr[i] == '-') {
            // 條件：若是第一個字元、或前面是左括號、或前面也是運算子，此時的 '-' 必定是「負號」
            if (tokens.empty() || tokens.back() == "(" || isOperator(tokens.back())) {
                string num = "-"; // 初始化為負數字串
                i++;
                // 繼續讀取後面緊接的數字部分
                while (i < n && (isdigit(expr[i]) || expr[i] == '.')) {
                    num += expr[i];
                    i++;
                }
                tokens.push_back(num); // 將負數 (例如 "-5.2") 放入 tokens 陣列
                i--; // 一樣退回一格，避免 for 迴圈多算
            } else {
                tokens.push_back("-"); // 若不符合上述條件，則為單純的「減法運算子」
            }
        } 
        // 處理其他單一字元 (如 +, *, /, %, ^, (, ) )
        else {
            tokens.push_back(string(1, expr[i])); // 將字元轉成字串並放入陣列
        }
    }
    return tokens; // 回傳解析完畢的 Token 向量陣列
}

// ==========================================
// 4. Infix 轉 Postfix (Shunting Yard 演算法)
// ==========================================
vector<string> infixToPostfix(const vector<string>& tokens) {
    vector<string> postfix;        // 儲存轉換後的後序運算式結果 (佇列效果)
    LinkedListStack<char> opStack; // 暫存運算子的堆疊

    for (const string& token : tokens) {
        // 判斷是否為數字：長度大於1(必為多位數或負數)、或是單一字元數字、或是負數開頭
        if (token.length() > 1 || isdigit(token[0]) || (token[0] == '-' && token.length() > 1)) {
            postfix.push_back(token); // 數字在後序表示法中，直接輸出
        } 
        else if (token == "(") {
            opStack.push('('); // 遇到左括號，直接推入運算子堆疊
        } 
        else if (token == ")") {
            // 遇到右括號，開始彈出堆疊內的運算子並輸出，直到遇見左括號為止
            while (!opStack.isEmpty() && opStack.peek() != '(') {
                postfix.push_back(string(1, opStack.peek()));
                opStack.pop();
            }
            if (!opStack.isEmpty() && opStack.peek() == '(') {
                opStack.pop(); // 找到對應的左括號，將其彈出並捨棄 (括號不輸出)
            }
        } 
        else { // 遇到一般的運算子 (+, -, *, /, %, ^)
            char op = token[0]; // 取出該運算子字元
            // 比較目前運算子與堆疊頂端運算子的優先級
            // 當堆疊頂端的優先級「大於或等於」目前的運算子時，需將堆疊頂端彈出並輸出
            while (!opStack.isEmpty() && getPrecedence(opStack.peek()) >= getPrecedence(op)) {
                // 特例處理：次方(^)是「右結合性」(Right-associative)
                // 若兩者都是 '^'，則右邊的先算，所以不將堆疊內的 '^' 彈出，直接跳出迴圈
                if (op == '^' && opStack.peek() == '^') break; 
                postfix.push_back(string(1, opStack.peek())); // 彈出並輸出
                opStack.pop();
            }
            opStack.push(op); // 將目前的運算子推入堆疊中
        }
    }

    // 當所有 Token 掃描完畢，將堆疊內剩餘的所有運算子依序彈出並輸出
    while (!opStack.isEmpty()) {
        postfix.push_back(string(1, opStack.peek()));
        opStack.pop();
    }

    return postfix; // 回傳最終轉換好的後序表示法陣列
}

// ==========================================
// 5. Postfix 運算器
// ==========================================
double evaluatePostfix(const vector<string>& postfix) {
    LinkedListStack<double> valStack; // 儲存操作數(數值)的堆疊

    for (const string& token : postfix) {
        // 如果是數字 (包含正負數、浮點數)，轉成 double 後推入堆疊
        if (token.length() > 1 || isdigit(token[0]) || (token[0] == '-' && token.length() > 1)) {
            valStack.push(stod(token)); // stod：將字串轉成 double 型態
        } 
        else { // 如果是運算子，則從堆疊中取出兩個數字進行運算
            if (valStack.isEmpty()) throw runtime_error("Error: Invalid expression.");
            double val2 = valStack.peek(); valStack.pop(); // 先彈出的是右操作數 (後面的數)
            
            if (valStack.isEmpty()) throw runtime_error("Error: Invalid expression.");
            double val1 = valStack.peek(); valStack.pop(); // 後彈出的是左操作數 (前面的數)

            char op = token[0]; // 取得運算子
            // 依據不同的運算子進行對應的數學計算，並把結果重新推回堆疊
            if (op == '+') valStack.push(val1 + val2);
            else if (op == '-') valStack.push(val1 - val2);
            else if (op == '*') valStack.push(val1 * val2);
            else if (op == '/') {
                if (val2 == 0) throw runtime_error("Error: Division by zero."); // 檢查除以零的錯誤
                valStack.push(val1 / val2);
            }
            else if (op == '^') valStack.push(pow(val1, val2)); // 計算 val1 的 val2 次方
            else if (op == '%') valStack.push(fmod(val1, val2)); // 浮點數取餘數 (例如 5.5 % 2 = 1.5)
        }
    }

    return valStack.peek(); // 運算結束後，堆疊內只會剩下一個值，即為最終答案
}

// ==========================================
// 6. 主程式與測試案例
// ==========================================

// 獨立的測試輔助函式 (此範例 main 中未使用，但可作為單元測試用)
void testCalculator(const string& expression) {
    try {
        vector<string> tokens = tokenize(expression);     // 步驟 1: 解析字串
        vector<string> postfix = infixToPostfix(tokens);  // 步驟 2: 轉後序
        double result = evaluatePostfix(postfix);         // 步驟 3: 算結果
        
        cout << "Input: " << expression << " \t-> Result: " << result << endl;
    } catch (const exception& e) {
        cout << "Input: " << expression << " \t-> " << e.what() << endl; // 捕捉並列印錯誤
    }
}

int main() {
    string input; // 宣告用來接收使用者輸入的字串變數
    
    // 列印歡迎介面與操作說明
    cout << "==========================================" << endl;
    cout << "       Linked List Stack Calculator       " << endl;
    cout << "==========================================" << endl;
    cout << "支援的運算子: +, -, *, /, ^, %" << endl;
    cout << "輸入您的數學公式，或輸入 'exit' 來結束程式。" << endl;
    cout << "------------------------------------------" << endl;

    // 啟動無限迴圈直到使用者主動退出
    while (true) {
        cout << "\n>> 請輸入公式: ";
        
        // 讀取整行輸入（包含空白），避免 cin >> input 遇到空格就斷掉
        if (!getline(cin, input)) {
            break; // 如果遇到串流結束 EOF (例如 Ctrl+D)，直接跳出迴圈
        }

        // 如果使用者直接按 Enter 沒有輸入內容，跳過本次迴圈重新詢問
        if (input.empty()) {
            continue;
        }

        // 檢查是否輸入退出指令
        if (input == "exit" || input == "quit") {
            cout << "結束計算機程式，掰掰！" << endl;
            break; // 終止迴圈，結束程式
        }

        try {
            // 1. 解析字串為 Token 陣列
            vector<string> tokens = tokenize(input);
            
            // 2. 將 中序(Infix) 轉換為 後序(Postfix)
            vector<string> postfix = infixToPostfix(tokens);
            
            // 3. 計算 後序 表示法並得出計算結果
            double result = evaluatePostfix(postfix);
            
            // 順利完成，輸出計算結果
            cout << "=> 結果: " << result << endl;
            
        } catch (const exception& e) {
            // 捕捉執行過程中所有的錯誤（如：除以零、公式格式錯誤等）
            // 並列印出具體的錯誤原因，使程式不會崩潰直接關閉
            cout << "=> 發生錯誤: " << e.what() << endl;
        }
    }

    return 0; // 程式正常結束
}
